# ──────────────────────────────────────────────────────────────────────────
# Rollr Backend — environment variables
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file.
# ──────────────────────────────────────────────────────────────────────────

# --- Server ---
PORT=3000
NODE_ENV=development

# --- PostgreSQL (use the Supabase "Connection string" / Postgres URL) ---
# Supabase Dashboard → Project Settings → Database → Connection string (URI).
# Use the "Session" pooler or direct connection. Example:
# postgresql://postgres:[PASSWORD]@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# --- Supabase (Dashboard → Project Settings → API) ---
SUPABASE_URL=https://your-project-ref.supabase.co
# Public anon key — safe to expose to clients
SUPABASE_ANON_KEY=your-anon-key
# Service role key — SECRET. Server-side only. Bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin login (hardcoded for MVP — Phase 1) ---
# TODO(Future): replace hardcoded admin with a proper admin users table + RBAC.
ADMIN_EMAIL=admin@rollr.test
ADMIN_PASSWORD=ChangeMe_Admin123!
# Secret used to sign the backend-issued admin JWT. Use a long random string.
ADMIN_JWT_SECRET=replace-with-a-long-random-secret
ADMIN_JWT_EXPIRES_IN=12h

# --- Seed credentials (used by `npm run db:seed`) ---
SEED_MECHANIC_EMAIL=mechanic@rollr.test
SEED_MECHANIC_PASSWORD=ChangeMe_Mech123!
SEED_CUSTOMER_EMAIL=customer@rollr.test
SEED_CUSTOMER_PASSWORD=ChangeMe_Cust123!

# --- CORS (comma separated; * allows all for local dev) ---
CORS_ORIGIN=*

# TODO(Phase 3+): STRIPE_SECRET_KEY, push notification keys, etc.
