# ──────────────────────────────────────────────────────────────────────────
# Rollr Mobile (Expo) — environment variables
# Copy to `.env`. Only EXPO_PUBLIC_* vars are exposed to the app at runtime.
# ──────────────────────────────────────────────────────────────────────────

# Backend API base URL (include the /api suffix).
# - iOS Simulator:    http://localhost:3000/api
# - Android emulator: http://10.0.2.2:3000/api
# - Physical device:  http://<YOUR-LAN-IP>:3000/api   (e.g. http://192.168.1.20:3000/api)
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Supabase (Dashboard → Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Storage bucket used for repair-request photos (Phase 2).
# Create a PUBLIC bucket with this name in the Supabase dashboard.
EXPO_PUBLIC_SUPABASE_PHOTO_BUCKET=job-photos
